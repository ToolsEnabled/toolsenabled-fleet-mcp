{
  "name": "toolsenabled-fleet",
  "version": "1.9.2-rc.1",
  "description": "Shared project tasks, local memory and coordinated file edits.",
  "author": {
    "name": "ToolsEnabled, Inc.",
    "email": "support@toolsenabled.ai"
  },
  "homepage": "https://toolsenabled.ai",
  "license": "MIT",
  "skills": "./codex-skills/",
  "hooks": "./codex-hooks.json",
  "mcpServers": {
    "fleet-mcp": {
      "command": "node",
      "args": [
        "./codex-entry.js"
      ],
      "cwd": "./",
      "env_vars": [
        "FLEET_MCP_CODEX_STATE_ROOT",
        "FLEET_MCP_CODEX_WORKSPACE"
      ]
    }
  },
  "interface": {
    "displayName": "ToolsEnabled Fleet",
    "shortDescription": "Coordinate local project work",
    "longDescription": "Coordinate project tasks, ledger progress, local memory, search and file edits in an explicitly selected workspace. This package requires Standard permissions with workers off.",
    "developerName": "ToolsEnabled, Inc.",
    "category": "Productivity",
    "websiteURL": "https://toolsenabled.ai",
    "privacyPolicyURL": "https://github.com/ToolsEnabled/toolsenabled-fleet-mcp/blob/main/PRIVACY.md",
    "capabilities": [
      "Read",
      "Write"
    ],
    "supportURL": "https://github.com/ToolsEnabled/toolsenabled-fleet-mcp/issues"
  }
}
